// envstore — data model
// Hierarchy: Workspace → Project → Environment → EnvFileVersion (with rollback pointer)
// Zero-knowledge: only PUBLIC recipients (age1.../ssh-ed25519) ever touch the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in `prisma.config.ts` (for migrate) and
  // are passed to PrismaClient via the @prisma/adapter-pg constructor.
}

// =============================================================================
// Auth.js v5 standard tables
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Paddle Customer ID — one record per user, reused across every workspace
  // they subscribe to. Set on first checkout; never rotated.
  paddleCustomerId String? @unique

  accounts         Account[]
  sessions         Session[]
  recipients       UserRecipient[]
  workspaceMembers     WorkspaceMember[]
  ownedWorkspaces      Workspace[]            @relation("WorkspaceOwner")
  cliTokens            CliToken[]
  workspaceTokensCreated WorkspaceToken[]     @relation("WorkspaceTokenCreator")
  auditLogs            AuditLog[]
  invitesSent          Invite[]               @relation("InvitedBy")
  versionsCreated      EnvFileVersion[]
  deviceAuthorizations DeviceAuthorization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Reused for Email OTP: identifier=email, token=sha256(code), expires=10min
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  attempts   Int      @default(0)
  type       String   @default("email-otp")

  @@id([identifier, token])
  @@index([identifier])
}

// =============================================================================
// Zero-knowledge identity — PUBLIC recipients only.
// We deliberately never store any private key material.
// =============================================================================

model UserRecipient {
  id         String        @id @default(cuid())
  userId     String
  recipient  String        // "age1..." or "ssh-ed25519 AAAA..."
  kind       RecipientKind
  label      String        // user-facing — "MacBook Pro Keychain", "YubiKey blue"
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipient])
  @@index([userId])
}

enum RecipientKind {
  AGE_X25519
  SSH_ED25519
  SSH_RSA
}

// =============================================================================
// Workspaces — the billing unit
// =============================================================================

model Workspace {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  type        WorkspaceType @default(TEAM)
  ownerId     String

  // Soft delete + per-workspace retention setting for nested soft-deletes
  deletedAt               DateTime?
  softDeleteRetentionDays Int       @default(30)

  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  invites       Invite[]
  projects      Project[]
  projectGroups ProjectGroup[]
  tokens        WorkspaceToken[]
  subscription  Subscription?
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([deletedAt])
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Invite {
  id              String        @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole @default(MEMBER)
  tokenHash       String        @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([workspaceId, acceptedAt])
  @@index([email])
}

// =============================================================================
// Projects → Environments → Versions
// =============================================================================

model ProjectGroup {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String?
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, deletedAt])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String?
  deletedAt   DateTime?
  // Single durable setup code shown on the project page. Anyone with workspace
  // membership can redeem it with `envstore link <CODE>` to get envstore.json.
  // Nullable only so legacy rows can be lazy-filled on first read.
  linkCode    String?   @unique
  // Optional grouping — projects in the same group are shown together on the
  // workspace dashboard and get their own group page. Null means "standalone".
  groupId     String?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group        ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  environments Environment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, groupId])
  @@index([workspaceId, deletedAt])
}

model Environment {
  id        String    @id @default(cuid())
  projectId String
  slug      String
  name      String
  deletedAt DateTime?

  // Rollback pointer — moving this is the "make current" operation.
  // SetNull so versions can be hard-deleted without breaking the env row.
  currentVersionId String? @unique

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentVersion EnvFileVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       EnvFileVersion[] @relation("EnvVersions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, deletedAt])
}

model EnvFileVersion {
  id            String @id @default(cuid())
  environmentId String
  version       Int

  r2Key            String
  ciphertextSize   Int
  ciphertextSha256 Bytes
  recipientsHash   Bytes // hash of sorted recipient set this was encrypted to

  comment         String?
  createdByUserId String

  createdAt DateTime @default(now())

  environment   Environment  @relation("EnvVersions", fields: [environmentId], references: [id], onDelete: Cascade)
  currentForEnv Environment? @relation("CurrentVersion")
  createdBy     User         @relation(fields: [createdByUserId], references: [id])

  @@unique([environmentId, version])
  @@index([environmentId, createdAt])
}

// =============================================================================
// CLI auth
// =============================================================================

model CliToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique // sha256(token) — token is shown to user once on creation
  lastUsedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Workspace-scoped service token for CI/CD pulls and pushes. Not tied to a
// user: the credential survives offboarding the human who minted it and
// authorizes the holder to read/write secrets in this workspace only.
//
// The bearer (shown once at creation, then sha256-hashed at rest) authorizes
// the API call. The `recipient` is the public half of an age keypair generated
// on the minting machine — the server never sees the private key. Push
// encrypts to this recipient alongside human members, so the CI runner can
// decrypt with the private half it holds in its secret store.
//
// Tokens cannot escalate: the mutating API endpoints (token create/revoke,
// invites, role changes, billing, settings, deletes) accept only user-auth.
model WorkspaceToken {
  id              String        @id @default(cuid())
  workspaceId     String
  name            String        // user-facing label, e.g. "ci-prod"
  tokenHash       String        @unique // sha256(token); bearer shown once
  recipient       String        // public age recipient (or ssh-ed25519 key)
  recipientKind   RecipientKind @default(AGE_X25519)
  // Coarse permission flags. v1 only has "read" and "write"; we keep the
  // shape so finer-grained scoping (per-project, per-env) can layer on later
  // without a migration.
  scopes          String[]      @default(["read", "write"])
  expiresAt       DateTime?     // nullable = no expiry (discouraged but allowed)
  revokedAt       DateTime?     // immediate revocation; auth path rejects
  lastUsedAt      DateTime?
  createdByUserId String

  createdAt DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation("WorkspaceTokenCreator", fields: [createdByUserId], references: [id])
  auditLogs AuditLog[]

  @@index([workspaceId, revokedAt])
  @@index([createdByUserId])
}

// OAuth 2.0 device-authorization grant (RFC 8628).
// The CLI hits /api/cli/device/start, gets a deviceCode + userCode, then opens
// the user's browser to /cli/<userCode> for approval while polling
// /api/cli/device/poll with the deviceCode. On approval we mint a CliToken and
// return it on the next poll.
//
// deviceCodeHash is sha256(deviceCode) — the raw deviceCode is only ever held
// in the CLI's memory and over TLS. userCode is the short human-typeable code
// that lives in the browser URL (lower entropy, but expires fast).
model DeviceAuthorization {
  id              String                    @id @default(cuid())
  deviceCodeHash  String                    @unique
  userCode        String                    @unique
  clientName      String?
  ipAddress       String?
  status          DeviceAuthorizationStatus @default(PENDING)
  expiresAt       DateTime
  pollIntervalSec Int                       @default(5)
  lastPolledAt    DateTime?
  pollAttempts    Int                       @default(0)

  approvedByUserId String?
  approvedAt       DateTime?
  cliTokenId       String? // populated when status = APPROVED

  createdAt DateTime @default(now())

  approvedBy User? @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([status, expiresAt])
}

enum DeviceAuthorizationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CONSUMED // token has been delivered to the CLI; cannot be re-fetched
}

// =============================================================================
// Audit log
// =============================================================================

model AuditLog {
  id           String  @id @default(cuid())
  workspaceId  String?
  userId       String?
  // Populated when the action was authenticated via a workspace service token
  // instead of a human user session. Either userId, workspaceTokenId, or
  // neither (system-initiated, e.g. billing webhook) can be set — never both
  // in normal flow.
  workspaceTokenId String?
  action       String
  resourceType String?
  resourceId   String?
  // Intentionally NO ipAddress or userAgent: those are personal data under
  // GDPR and the audit log keeps no log-shipping retention argument for them.
  // Actor + action + timestamp is enough for "who changed what, when".
  metadata     Json?

  createdAt DateTime @default(now())

  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceToken WorkspaceToken? @relation(fields: [workspaceTokenId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([workspaceTokenId, createdAt])
}

// =============================================================================
// Billing — one subscription per workspace, including personal
// =============================================================================

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  paddleSubscriptionId String?            @unique
  paddlePriceId        String?
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

// Paddle webhook idempotency — we record every event we've processed so retries
// from Paddle (or replays from our queue) don't double-apply. Rows are kept
// indefinitely for audit; a future cron can prune events older than ~90 days.
model PaddleWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // Paddle's event_id (evt_...) — the idempotency key
  eventType   String   // e.g. "subscription.activated"
  payload     Json     // full webhook body for debugging / replay
  processedAt DateTime @default(now())

  @@index([eventType, processedAt])
}
