{
  "name": "@envstore/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -e ../../.env.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -e ../../.env.local -- prisma migrate deploy",
    "push": "dotenv -e ../../.env -e ../../.env.local -- prisma db push",
    "studio": "dotenv -e ../../.env -e ../../.env.local -- prisma studio",
    "format": "prisma format",
    "typecheck": "tsc --noEmit",
    "topo": "echo 'db topo ok'"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@envstore/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.0"
  }
}
