{
  "extends": "@envstore/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  // *.test.ts is covered by `bun test` at runtime; see packages/shared/tsconfig.json.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
