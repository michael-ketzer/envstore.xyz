{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "VERCEL_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "bin/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "AUTH_SECRET",
        "AUTH_URL",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_WEBHOOK_SECRET",
        "RESEND_INBOUND_FORWARD_TO",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "R2_JURISDICTION",
        "PADDLE_API_KEY",
        "PADDLE_WEBHOOK_SECRET",
        "PADDLE_ENV",
        "PADDLE_PRICE_ID_TEAM",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_PADDLE_CLIENT_TOKEN"
      ]
    },
    "@envstore/db#build": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "generate": {
      "cache": false,
      "outputs": ["**/generated/**"]
    },
    "clean": {
      "cache": false
    },
    "topo": {
      "dependsOn": ["^topo"]
    }
  }
}
