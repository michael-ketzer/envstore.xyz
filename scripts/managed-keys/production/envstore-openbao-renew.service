[Unit]
Description=Renew envstore OpenBao credentials and check health
After=envstore-openbao.service
[Service]
Type=oneshot
User=root
UMask=0077
LoadCredentialEncrypted=operations.json:/etc/envstore-openbao/operations.json.cred
ExecStart=/usr/bin/python3 /opt/envstore-openbao/maintenance.py renew
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/envstore-openbao/maintenance
