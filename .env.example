# ---------------------------------------------------------------------------
# envstore environment variables
# Copy this file to .env (or .env.local) at the repo root and fill in values.
# Both Prisma (`pnpm db:*`) and Next.js (`pnpm dev`) read from this single file.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Optional values are commented out — uncomment and fill if you need that feature.
# ---------------------------------------------------------------------------

# ---------- REQUIRED ----------

# Neon Postgres — pooled connection (runtime queries)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/envstore?sslmode=require&pgbouncer=true"
# Neon Postgres — unpooled (used by `prisma migrate` and `prisma db push`)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/envstore?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of this Next.js app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- OPTIONAL ----------

# Auth.js — override only when not running on NEXT_PUBLIC_APP_URL
# AUTH_URL="http://localhost:3000"

# GitHub OAuth — https://github.com/settings/developers
# Callback: $NEXT_PUBLIC_APP_URL/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback: $NEXT_PUBLIC_APP_URL/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Email (Resend) — without these, OTP codes are printed to the dev terminal
# RESEND_API_KEY=
# RESEND_FROM="envstore <noreply@envstore.xyz>"

# Object storage (Cloudflare R2) — required for push/pull
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET="envstore-secrets"
# Set to "eu" or "fedramp" only if the bucket was created with that jurisdiction
# (wrangler r2 bucket create --jurisdiction eu). Location hints like WEUR do not
# count — leave this unset for hint-only buckets.
# R2_JURISDICTION="default"

# Billing (Paddle) — required for production billing flows
# PADDLE_ENV="sandbox"
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
